# Required for dashboard/auth
AUTH_SECRET=<generate with: openssl rand -base64 32>
AUTH_GITHUB_ID=<from github oauth app>
AUTH_GITHUB_SECRET=<from github oauth app>

# Vercel KV (add KV database in Vercel dashboard)
KV_URL=...
KV_REST_API_URL=...
KV_REST_API_TOKEN=...
KV_REST_API_READ_ONLY_TOKEN=...

# Internal agent keys (comma-separated, for Ace/Mia/etc.)
AGENT_API_KEYS=csk_your_internal_key

# App URL
BASE_URL=https://claw-setups.vercel.app
